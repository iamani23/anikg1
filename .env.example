# Copy to .env and fill in. Do NOT commit real secrets.

# --- LLM (required for `pm-kg ask`) ---
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5)
# PMKG_MODEL=claude-sonnet-5

# --- Graph data ---
# Comma-separated Turtle files to load (defaults to the bundled sample)
# PMKG_DATA=data/sample/sample_data.ttl
# Optional remote SPARQL endpoint instead of local rdflib (step 3)
# PMKG_SPARQL_ENDPOINT=http://localhost:3030/pmkg/sparql

# --- JIRA (step 2) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
